{
  "expo": {
    "name": "TRAZA",
    "slug": "traza",
    "scheme": "traza",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#101816",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "mx.traza.app"
    },
    "android": {
      "package": "mx.traza.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#101816",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TRAZA usa tu ubicación para medir la distancia durante una rodada.",
          "locationAlwaysAndWhenInUsePermission": "TRAZA usa tu ubicación durante una rodada, incluso con la pantalla bloqueada.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-sqlite",
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "91f4de07-ec29-4368-b7b8-2b1875c522c9"
      }
    },
    "owner": "zeuscach",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/91f4de07-ec29-4368-b7b8-2b1875c522c9"
    }
  }
}
