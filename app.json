{
  "expo": {
    "name": "TRAZA",
    "slug": "traza",
    "scheme": "traza",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#101816",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "mx.traza.app"
    },
    "android": {
      "package": "mx.traza.app",
      "adaptiveIcon": {
        "backgroundColor": "#101816",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TRAZA usa tu ubicación para medir la distancia durante una rodada.",
          "locationAlwaysAndWhenInUsePermission": "TRAZA usa tu ubicación durante una rodada, incluso con la pantalla bloqueada.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
